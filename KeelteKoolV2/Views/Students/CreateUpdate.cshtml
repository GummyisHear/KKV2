@model KeelteKoolV2.Models.Students.StudentCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>Muuda õpilast</h1>
}
else
{
    <h1>Lisa uus õpilane</h1>
}

<div>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input asp-for="Id" type="hidden" />

        <div class="form-group">
            <label asp-for="FirstName" class="control-label"></label>
            <input id="CU_Student_FirstName" asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LastName" class="control-label"></label>
            <input id="CU_Student_LastName" asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Grades" class="control-label"></label>
            <input id="CU_Student_Grades" asp-for="Grades" class="form-control" />
            <span asp-validation-for="Grades" class="text-danger"></span>
        </div>

        @if (Model.Id.HasValue)
        {
            <input id="CU_Update_BTN" asp-action="Update" asp-controller="Students" type="submit" value="Muuda" class="btn btn-success" />
        }
        else
        {
            <input id="CU_Create_BTN" asp-action="Create" asp-controller="Students" type="submit" value="Loo" class="btn btn-success" />
        }
        <a id="CU_Cancel_BTN" asp-action="Index" asp-controller="Students" class="btn btn-secondary">Tagasi</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
