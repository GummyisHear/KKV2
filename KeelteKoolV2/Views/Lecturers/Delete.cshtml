@model KeelteKoolV2.Models.Lecturers.LecturerViewModel

@{
    ViewData["Title"] = "Delete Lecturer";
}

<h1>Delete Lecturer</h1>

<h3>Are you sure you want to delete this lecturer?</h3>

<dl class="row">
    <dt class="col-sm-2">
        First name
    </dt>

    <dd class="col-sm-10">
        @Model.FirstName
    </dd>

    <dt class="col-sm-2">
        Last name
    </dt>

    <dd class="col-sm-10">
        @Model.LastName
    </dd>

    <dt class="col-sm-2">
        Qualifications
    </dt>

    <dd class="col-sm-10">
        @Model.Qualifications
    </dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <button id="DeleteDelete_BTN"
            type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a id="DeleteCancel_BTN"
       asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>
</form>